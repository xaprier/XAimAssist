  CommonColor
  CommonCore
  FiltersSources
  GUISupportQt
  InteractionStyle
  RenderingCore
  RenderingOpenGL2
)

include("${CMAKE_CURRENT_LIST_DIR}/XAimAssistTargets.cmake")
