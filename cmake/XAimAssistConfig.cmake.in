@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 6.5 REQUIRED COMPONENTS
  Core
  Gui
  Widgets
  Sql
  Qml
  Quick
  QuickWidgets
  QuickControls2
)

